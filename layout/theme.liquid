<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0"
    >
    <meta name="theme-color" content="{{ settings.header_background }}">

    {%- liquid
      assign seo_title = page_title
      assign seo_description = page_description

      if request.page_type == 'index'
        assign seo_title = 'Soliseed Grow Lights for Indoor Plants | Every Spot Can Grow'
        assign seo_description = 'Find full-spectrum white grow lights for desk plants, plant shelves, kitchen herbs, dark corners, living room plant corners, and indoor growing setups.'
      elsif request.page_type == 'collection' and collection.handle == 'all'
        assign seo_title = 'Soliseed Grow Lights and Indoor Plant Lighting Setups'
        assign seo_description = 'Shop Soliseed grow lights for indoor plants, shelves, desks, kitchen herbs, seedlings, and home growing spaces.'
      elsif request.page_type == 'blog' and blog.handle == 'how-to'
        assign seo_title = 'Indoor Plant Grow Light Guides | Soliseed How To'
        assign seo_description = 'Read Soliseed grow light guides for indoor plants, setup tips, plant care, light placement, timers, and choosing the right grow light for your space.'
      elsif request.page_type == 'page'
        case page.handle
          when 'contact'
            assign seo_title = 'Contact Soliseed Support'
            assign seo_description = 'Contact Soliseed for grow light setup help, warranty support, product questions, and Amazon order guidance.'
          when 'find-my-setup'
            assign seo_description = 'Choose the right Soliseed grow light setup by plant spot, space, and setup type.'
          when 'grow-lights-for-desk-plants'
            assign seo_description = 'Find compact grow light setups for desk plants, small workspaces, and indoor plant groupings.'
          when 'grow-lights-for-plant-shelves'
            assign seo_description = 'Explore grow light setups for plant shelves, plant racks, and multi-level indoor displays.'
          when 'grow-lights-for-dark-corners'
            assign seo_description = 'Make low-light corners plant-ready with focused Soliseed grow light setups for indoor plants.'
          when 'grow-lights-for-kitchen-herbs'
            assign seo_description = 'Support basil, mint, rosemary, and kitchen herbs with compact grow light setups for counters and windowsills.'
          when 'grow-lights-for-living-room-plant-corners'
            assign seo_description = 'Find home-friendly grow light setups for living room plant corners and grouped houseplants.'
          when 'grow-lights-for-greenhouse-seedlings'
            assign seo_description = 'Support seedlings, propagation trays, and greenhouse starts with practical supplemental grow light setups.'
          when 'setup-guide'
            assign seo_description = 'Learn how to set up your Soliseed grow light with placement, distance, timer, and adjustment basics.'
          when 'warranty-registration'
            assign seo_description = 'Register your Soliseed grow light and find post-purchase support.'
        endcase
      endif
    -%}

    <title>
      {%- if seo_title == blank -%}
        {{- shop.name -}}
      {%- else -%}
        {{- seo_title -}}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page -}}{% endif -%}
      {%- endif -%}
    </title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}
      Few prefech to increase performance on commonly used third-parties.
    {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {% render 'social-meta-tags' %}
    {% render 'microdata-schema' %}
    {% render 'css-variables' %}
    {% render 'js-variables' %}
    {% render 'blocking-utility' %}

    {%- comment -%}
      IMPLEMENTATION NOTE: for improving performance, Zalify tries to preload images on known pages (such as blog page, product or collection pages). In order to keep a main JS file size minimal, the theme also lazyloads non-essential libraries (such as PhotoSwipe or Flickity) and only loads them on demand.
    {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      <link rel="preload" as="fetch" href="{{ product.url }}.js" crossorigin>

      {%- if product.media.size > 1 -%}
        <link rel="preload" as="script" href="{{ 'flickity.js' | asset_url }}">
      {%- endif -%}
    {%- endif -%}

    <script type="module" src="{{ 'vendor.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
    <script type="module" src="{{ 'custom.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    {{- 'custom.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  {%- assign feature_classes = '' -%}
  {%- if settings.show_image_zoom -%}
    {% assign feature_classes = feature_classes | append: ' features--image-zoom' %}
  {%- endif -%}

  <body class="no-focus-outline {{ feature_classes }}" data-instant-allow-query-string>
    {%- comment -%}
      Common SVG definitions that we are re-using in several places.
    {%- endcomment -%}
    <svg class="visually-hidden">
      <linearGradient id="rating-star-gradient-half">
        <stop offset="50%" stop-color="rgb(var(--product-star-rating))" />
        <stop offset="50%" stop-color="rgb(var(--product-star-rating))" stop-opacity="0.4" />
      </linearGradient>
    </svg>

    <a href="#main" class="visually-hidden skip-to-content">{{ 'general.accessibility.skip_to_content' | t }}</a>
    <loading-bar class="loading-bar"></loading-bar>

    {%- if request.page_type != 'gift_card' and request.page_type != 'password' -%}
      {%- unless settings.block_cn_hk_ips and request.path == settings.unavailable_page.url -%}
        {%- sections 'header-group' -%}
        {%- sections 'overlay-group' -%}
      {%- endunless -%}
    {%- endif -%}

    <div id="main" role="main" class="anchor">
      {%- comment -%}
        IMPLEMENTATION NOTE: on collection and search page, the theme was designed to show on mobile the filter bar and/or sort by at the very top of the page. However, due to the fact that sections are isolated, I had to move the code here. Then, the collection section, based on the selected settings, will eventually hide those elements in CSS.
      {%- endcomment -%}
      {%- if request.page_type == 'collection' or request.page_type == 'search' -%}
        {%- assign active_filters_count = 0 -%}

        {%- if request.page_type == 'collection' -%}
          {%- assign filters = collection.filters -%}
        {%- else -%}
          {%- assign filters = search.filters -%}
        {%- endif -%}

        {%- for filter in filters -%}
          {%- if filter.type == 'list' -%}
            {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
          {%- elsif filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
            {%- assign active_filters_count = active_filters_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign is_toolbar_collapsed = false -%}

        {%- if request.page_type == 'search'
          and search.results.first.object_type != 'product'
          and search.results_count > 0
        -%}
          {%- assign is_toolbar_collapsed = true -%}
        {%- endif -%}

        <div
          id="mobile-facet-toolbar"
          class="mobile-toolbar {% if is_toolbar_collapsed %}is-collapsed{% endif %} hidden-lap-and-up"
        >
          <button
            is="toggle-button"
            class="mobile-toolbar__item mobile-toolbar__item--filters {% if active_filters_count > 0 %}has-filters{% endif %}"
            aria-expanded="false"
            aria-controls="facet-filters"
            style="display: none"
          >
            {%- render 'icon' with 'filter', width: 16, height: 16 -%}
            <span class="mobile-toolbar__item-label">{{- 'collection.general.filters' | t -}}</span>
          </button>

          <button
            is="toggle-button"
            class="mobile-toolbar__item mobile-toolbar__item--sort"
            aria-expanded="false"
            aria-controls="sort-by-popover"
            style="display: none"
          >
            <span class="mobile-toolbar__item-label">{{- 'collection.general.sort_by' | t -}}</span>
            {%- render 'icon' with 'caret-down', width: 16, height: 16 -%}
          </button>
        </div>
      {%- endif -%}

      {{ content_for_layout }}
    </div>

    {%- if request.page_type != 'gift_card' and request.page_type != 'password' -%}
      {%- unless settings.block_cn_hk_ips and request.path == settings.unavailable_page.url -%}
        {%- sections 'footer-group' -%}
      {%- endunless -%}
    {%- endif -%}

    {%- if request.design_mode -%}
      {%- render 'activate-popup' -%}
    {%- endif -%}
  </body>
</html>
