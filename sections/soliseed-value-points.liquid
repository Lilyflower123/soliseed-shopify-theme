<style>
  #shopify-section-{{ section.id }} .soliseed-value-points {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .soliseed-value-point {
    padding: 24px;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-value-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <div class="soliseed-value-points">
        {%- for block in section.blocks -%}
          <div class="soliseed-value-point text-container" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h2 class="heading h4">{{ block.settings.title | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="rte">
                {{ block.settings.content }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed value points",
  "blocks": [
    {
      "type": "point",
      "name": "Value point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Full-spectrum white grow light"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed value points",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Full-spectrum white grow light"
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Flexible setup for real plant spots"
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Simple timer and everyday plant care"
          }
        }
      ]
    }
  ]
}
{% endschema %}