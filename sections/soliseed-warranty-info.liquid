<style>
  #shopify-section-{{ section.id }} .soliseed-warranty {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .soliseed-warranty-card {
    padding: 24px;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
  }

  #shopify-section-{{ section.id }} .soliseed-warranty__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
    justify-content: center;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-warranty {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <header class="section__header section__header--center text-container mx-auto">
        {%- if section.settings.title != blank -%}
          <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </header>

      <div class="soliseed-warranty">
        {%- for block in section.blocks -%}
          <div class="soliseed-warranty-card text-container" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="heading h4">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="rte">
                {{ block.settings.content }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="soliseed-warranty__buttons">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
          <a href="{{ section.settings.primary_link }}" class="button button--primary">
            {{- section.settings.primary_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="button button--secondary">
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed warranty info",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Register your Soliseed warranty."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Info item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed warranty info"
    }
  ]
}
{% endschema %}
