{%- liquid
  assign amazon_store_url = settings.amazon_store_url
-%}

<style>
  #shopify-section-{{ section.id }} .soliseed-hero {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .soliseed-hero__media {
    overflow: hidden;
    border-radius: var(--block-border-radius);
    background: rgb(var(--secondary-background));
  }

  #shopify-section-{{ section.id }} .soliseed-hero__media img,
  #shopify-section-{{ section.id }} .soliseed-hero__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: {{ section.settings.image_fit | default: 'contain' }};
    object-position: {{ section.settings.image_position | default: 'center center' }};
    display: block;
  }

  #shopify-section-{{ section.id }} .soliseed-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-hero {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 48px;
    }
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .section--padding {
      padding-top: 28px;
      padding-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .soliseed-hero {
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .soliseed-hero .heading.h1 {
      font-size: clamp(34px, 10vw, 44px);
      line-height: 1.04;
    }

    #shopify-section-{{ section.id }} .soliseed-hero__buttons {
      gap: 10px;
      margin-top: 18px;
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <div class="soliseed-hero">
        <div class="text-container">
          {%- if section.settings.subheading != blank -%}
            <p class="heading heading--small">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h1 class="heading h1">{{ section.settings.heading | escape }}</h1>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="rte">
              {{ section.settings.content }}
            </div>
          {%- endif -%}

          <div class="soliseed-hero__buttons">
            {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
              <a href="{{ section.settings.primary_link }}" class="button button--primary">
                {{- section.settings.primary_label | escape -}}
              </a>
            {%- endif -%}

            {%- if section.settings.show_amazon_cta and amazon_store_url != blank -%}
              <a href="{{ amazon_store_url }}" class="button button--secondary" target="_blank" rel="noopener">
                {{- section.settings.amazon_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="soliseed-hero__media">
          {%- if section.settings.image != blank -%}
            {%- assign hero_image_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{-
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                alt: hero_image_alt,
                sizes: '(max-width: 740px) 100vw, 50vw',
                widths: '600,800,1000,1200,1400'
            -}}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'soliseed-hero__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image display mode",
      "options": [
        {
          "value": "contain",
          "label": "Show full image"
        },
        {
          "value": "cover",
          "label": "Crop to fill"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "center center",
          "label": "Center center"
        },
        {
          "value": "center left",
          "label": "Center left"
        },
        {
          "value": "center right",
          "label": "Center right"
        },
        {
          "value": "top center",
          "label": "Top center"
        },
        {
          "value": "bottom center",
          "label": "Bottom center"
        }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Spot Can Grow."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Flexible grow lights for shelves, desks, corners, and indoor growing spaces.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Find My Setup"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "show_amazon_cta",
      "label": "Show Amazon button",
      "default": true
    },
    {
      "type": "text",
      "id": "amazon_label",
      "label": "Amazon button label",
      "default": "Shop on Amazon"
    }
  ],
  "presets": [
    {
      "name": "Soliseed hero"
    }
  ]
}
{% endschema %}
