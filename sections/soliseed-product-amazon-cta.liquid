<style>
  #shopify-section-{{ section.id }} .soliseed-product-amazon {
    display: grid;
    gap: 20px;
    align-items: center;
    padding: 24px;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
  }

  #shopify-section-{{ section.id }} .soliseed-product-amazon__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-product-amazon {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <div class="soliseed-product-amazon">
        <div class="text-container">
          {%- if section.settings.title != blank -%}
            <h2 class="heading h3">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="rte">
              {{ section.settings.content }}
            </div>
          {%- endif -%}
        </div>

        <div class="soliseed-product-amazon__buttons">
          {%- comment -%}SP-2026-005: approved single-PDP primary-CTA Attribution pilot.{%- endcomment -%}
          {%- if request.page_type == 'product' and product.id == 9029137039517 -%}
            <a href="https://www.amazon.com/dp/B0H3KNSJPZ?maas=maas_adg_39BA1EFE9EA2EFF688C5405C9BDE8FAB_afap_abs&amp;ref_=aa_maas&amp;tag=maas" class="button button--primary button--full" target="_blank" rel="noopener">
              {{- section.settings.amazon_label | default: 'Buy on Amazon' | escape -}}
            </a>
          {%- else -%}
            {%- render 'buy-on-amazon-button',
            product: product,
            label: section.settings.amazon_label,
            button_class: 'button button--primary button--full'
          -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed Amazon CTA",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ready to buy this Soliseed setup?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Amazon is the primary checkout channel. Use this product page to confirm the right growing spot and setup form before purchase.</p>"
    },
    {
      "type": "text",
      "id": "amazon_label",
      "label": "Amazon button label",
      "default": "Buy on Amazon"
    }
  ],
  "presets": [
    {
      "name": "Soliseed Amazon CTA"
    }
  ]
}
{% endschema %}
