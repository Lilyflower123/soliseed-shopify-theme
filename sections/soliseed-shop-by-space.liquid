<style>
  #shopify-section-{{ section.id }} .soliseed-card-grid {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .soliseed-card {
    min-height: 160px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
  }

  #shopify-section-{{ section.id }} .soliseed-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .soliseed-card__content {
    padding: 24px;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <header class="section__header section__header--center text-container mx-auto">
        {%- if section.settings.title != blank -%}
          <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </header>

      <div class="soliseed-card-grid">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="soliseed-card text-container" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{-
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'soliseed-card__image',
                  loading: 'lazy',
                  alt: block.settings.image_alt,
                  sizes: '(max-width: 740px) 100vw, 33vw',
                  widths: '360,540,720,900'
              -}}
            {%- endif -%}

            <span class="soliseed-card__content">
              <span>
                {%- if block.settings.title != blank -%}
                  <span class="heading h4">{{ block.settings.title | escape }}</span>
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <span class="rte">{{ block.settings.content }}</span>
                {%- endif -%}
              </span>

              <span class="heading heading--small link">{{ block.settings.link_label | escape }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed shop by space",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Start with where your plant lives."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Choose a grow light by desk, shelf, corner, kitchen, living room, or greenhouse setup.</p>"
    }
  ],
  "blocks": [
    {
      "type": "space",
      "name": "Space",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore setup"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed shop by space"
    }
  ]
}
{% endschema %}
