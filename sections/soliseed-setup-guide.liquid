<style>
  #shopify-section-{{ section.id }} .soliseed-guide-list {
    display: grid;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .soliseed-guide-step {
    padding: 24px;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-guide-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <header class="section__header section__header--center text-container mx-auto">
        {%- if section.settings.title != blank -%}
          <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </header>

      <div class="soliseed-guide-list">
        {%- for block in section.blocks -%}
          <div class="soliseed-guide-step text-container" {{ block.shopify_attributes }}>
            {%- if block.settings.step_label != blank -%}
              <p class="heading heading--small">{{ block.settings.step_label | escape }}</p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="heading h4">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="rte">
                {{ block.settings.content }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed setup guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Set up your Soliseed grow light."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Guide step",
      "settings": [
        {
          "type": "text",
          "id": "step_label",
          "label": "Step label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed setup guide"
    }
  ]
}
{% endschema %}
