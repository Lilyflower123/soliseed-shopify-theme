<style>
  #shopify-section-{{ section.id }} .soliseed-support {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .soliseed-support__links {
    display: grid;
    gap: 12px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-support {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    #shopify-section-{{ section.id }} .soliseed-support__links {
      min-width: 260px;
    }
  }
</style>

<section class="section">
  <div class="container">
    <div class="section__color-wrapper section__color-wrapper--boxed section--padding">
      <div class="soliseed-support">
        <div class="text-container">
          {%- if section.settings.title != blank -%}
            <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="rte">
              {{ section.settings.content }}
            </div>
          {%- endif -%}
        </div>

        <div class="soliseed-support__links">
          {%- if section.settings.setup_guide_label != blank and section.settings.setup_guide_link != blank -%}
            <a href="{{ section.settings.setup_guide_link }}" class="button button--primary button--full">
              {{- section.settings.setup_guide_label | escape -}}
            </a>
          {%- endif -%}

          {%- if section.settings.warranty_label != blank and section.settings.warranty_link != blank -%}
            <a href="{{ section.settings.warranty_link }}" class="button button--secondary button--full">
              {{- section.settings.warranty_label | escape -}}
            </a>
          {%- endif -%}

          {%- if section.settings.contact_label != blank and section.settings.contact_link != blank -%}
            <a href="{{ section.settings.contact_link }}" class="button button--secondary button--full">
              {{- section.settings.contact_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed support block",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Set up once. Grow with confidence."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Get placement, distance, timer, and warranty support for your Soliseed grow light.</p>"
    },
    {
      "type": "text",
      "id": "setup_guide_label",
      "label": "Setup guide label",
      "default": "View Setup Guide"
    },
    {
      "type": "url",
      "id": "setup_guide_link",
      "label": "Setup guide link"
    },
    {
      "type": "text",
      "id": "warranty_label",
      "label": "Warranty label",
      "default": "Register Warranty"
    },
    {
      "type": "url",
      "id": "warranty_link",
      "label": "Warranty link"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    }
  ],
  "presets": [
    {
      "name": "Soliseed support block"
    }
  ]
}
{% endschema %}