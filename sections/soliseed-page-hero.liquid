<style>
  #shopify-section-{{ section.id }} .soliseed-page-hero {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .soliseed-page-hero__media {
    overflow: hidden;
    border-radius: var(--block-border-radius);
    background: rgb(var(--secondary-background));
  }

  #shopify-section-{{ section.id }} .soliseed-page-hero__media img,
  #shopify-section-{{ section.id }} .soliseed-page-hero__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: {{ section.settings.image_position }} center;
  }

  #shopify-section-{{ section.id }} .soliseed-page-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-page-hero {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .soliseed-page-hero__media img,
    #shopify-section-{{ section.id }} .soliseed-page-hero__placeholder {
      aspect-ratio: 16 / 10;
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <div class="soliseed-page-hero">
        <div class="text-container">
          {%- if section.settings.eyebrow != blank -%}
            <p class="heading heading--small">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h1 class="heading h1">{{ section.settings.title | escape }}</h1>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="rte">
              {{ section.settings.content }}
            </div>
          {%- endif -%}

          {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
            <div class="soliseed-page-hero__buttons">
              {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
                <a href="{{ section.settings.primary_link }}" class="button button--primary">
                  {{- section.settings.primary_label | escape -}}
                </a>
              {%- endif -%}

              {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
                <a href="{{ section.settings.secondary_link }}" class="button button--secondary">
                  {{- section.settings.secondary_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_image -%}
          <div class="soliseed-page-hero__media">
            {%- if section.settings.image != blank -%}
              {{-
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 740px) 100vw, 45vw',
                  widths: '500,700,900,1200'
              -}}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'soliseed-page-hero__placeholder' }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed page hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every Spot Can Grow."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Soliseed page hero"
    }
  ]
}
{% endschema %}
