<section>
  {%- assign blog_display_title = blog.title -%}
  {%- if section.settings.custom_blog_title != blank -%}
    {%- assign blog_display_title = section.settings.custom_blog_title -%}
  {%- elsif blog.handle == 'how-to' -%}
    {%- assign blog_display_title = 'Indoor Plant Grow Light Guides' -%}
  {%- endif -%}

  {%- assign blog_intro = section.settings.blog_intro -%}
  {%- if blog_intro == blank and blog.handle == 'how-to' -%}
    {%- assign blog_intro = 'Practical setup advice for desk plants, plant shelves, kitchen herbs, dark corners, and everyday indoor growing spaces.' -%}
  {%- endif -%}

  {%- if blog.articles_count == 0 -%}
    <div class="empty-state text-container">
      <h1 class="heading h1">{{ blog_display_title }}</h1>

      <p class="text--large">{{ 'blog.general.empty' | t }}</p>

      <div class="button-wrapper">
        <a href="{{ routes.root_url }}" class="button button--primary">{{ 'blog.general.back_to_home' | t }}</a>
      </div>
    </div>
  {%- else -%}
    {%- if section.settings.show_blog_title -%}
      <div class="container">
        <div class="page-header">
          <div class="page-header__text-wrapper text-container">
            <h1 class="heading h1">{{ blog_display_title }}</h1>

            {%- if blog_intro != blank -%}
              <p class="text--large">{{ blog_intro | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <link-bar class="link-bar">
        <div class="container">
          <div class="link-bar__wrapper">
            <span class="link-bar__title heading heading--small text--subdued">{{ 'blog.general.view' | t }}</span>

            <div class="link-bar__scroller hide-scrollbar">
              <ul class="link-bar__linklist list--unstyled" role="list">
                <li class="link-bar__link-item {% if current_tags == blank %}link-bar__link-item--selected{% endif %}">
                  <a
                    href="{{ blog.url }}"
                    class="link-bar__link link--animated {% if current_tags == blank %}text--underlined{% endif %}"
                  >
                    {{- 'blog.general.all_posts' | t -}}
                  </a>
                </li>

                {%- for tag in blog.all_tags -%}
                  {%- assign show_tag = true -%}

                  {%- if section.settings.featured_tag_handles != blank -%}
                    {%- assign show_tag = false -%}
                    {%- assign featured_tag_handles = section.settings.featured_tag_handles | newline_to_br | split: '<br />' -%}
                    {%- assign tag_handle = tag | handle -%}

                    {%- for featured_tag_handle in featured_tag_handles -%}
                      {%- assign featured_tag_handle_clean = featured_tag_handle | strip -%}
                      {%- if featured_tag_handle_clean == tag_handle -%}
                        {%- assign show_tag = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {%- unless show_tag -%}
                    {%- continue -%}
                  {%- endunless -%}

                  <li class="link-bar__link-item {% if current_tags contains tag %}link-bar__link-item--selected{% endif %}">
                    {%- capture link_to_tag_replacement -%}class="link-bar__link link--animated {% if current_tags contains tag %}text--underlined{% endif %}" title={%- endcapture -%}

                    {%- if current_tags contains tag -%}
                      {{ tag | link_to_remove_tag: tag | replace: 'title=', link_to_tag_replacement }}
                    {%- else -%}
                      {{- tag | link_to_tag: tag | replace: 'title=', link_to_tag_replacement -}}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
      </link-bar>
    {%- endif -%}

    <div class="vertical-breather vertical-breather--margin vertical-breather--extra-tight">
      <div class="container">
        {%- paginate blog.articles by section.settings.articles_per_page -%}
          <article-list
            {% if settings.stagger_blog_posts_apparition %}
              stagger-apparition
            {% endif %}
            class="article-list article-list--stacked"
          >
            {%- for article in blog.articles -%}
              {%- render 'article-item', article: article, heading_size: 'h4' -%}
            {%- endfor -%}
          </article-list>

          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main blog",
  "class": "shopify-section--main-blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_blog_title",
      "label": "Show blog title",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_blog_title",
      "label": "Custom blog title"
    },
    {
      "type": "text",
      "id": "blog_intro",
      "label": "Blog intro"
    },
    {
      "type": "textarea",
      "id": "featured_tag_handles",
      "label": "Featured tag handles",
      "info": "Optional. Add one tag handle per line to limit the blog tag bar.",
      "default": "grow-light\nkitchen-herb-garden\nplant-shelf\nclip-on-grow-light\nwindowsill-herbs"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "info": "The first article's tag will be shown as category.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "info": "Change excerpts by editing your blog posts. [Learn more](https://help.shopify.com/en/manual/online-store/blogs/writing-blogs#display-an-excerpt-from-a-blog-post)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Blog posts per page",
      "min": 3,
      "max": 48,
      "step": 3,
      "default": 9
    }
  ]
}
{% endschema %}
