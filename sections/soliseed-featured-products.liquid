<style>
  #shopify-section-{{ section.id }} .soliseed-product-grid {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__media {
    overflow: hidden;
    border-radius: var(--block-border-radius);
    background: rgb(var(--secondary-background));
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__media img,
  #shopify-section-{{ section.id }} .soliseed-product-card__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__title {
    margin: 0;
    font-size: 17px;
    line-height: 1.28;
    font-weight: 700;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__title a,
  #shopify-section-{{ section.id }} .soliseed-product-card__title span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .soliseed-product-card__cta {
    margin-top: auto;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .soliseed-product-card__title {
      font-size: 20px;
      line-height: 1.25;
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <header class="section__header section__header--center text-container mx-auto">
        {%- if section.settings.title != blank -%}
          <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </header>

      <div class="soliseed-product-grid">
        {%- for block in section.blocks -%}
          {%- assign featured_product = block.settings.product -%}

          <div class="soliseed-product-card" {{ block.shopify_attributes }}>
            <a href="{{ featured_product.url | default: '#' }}" class="soliseed-product-card__media">
              {%- if featured_product.featured_media != blank -%}
                {{-
                  featured_product.featured_media
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 740px) 100vw, 25vw',
                    widths: '350,500,700'
                -}}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'soliseed-product-card__placeholder' }}
              {%- endif -%}
            </a>

            <div class="soliseed-product-card__content text-container">
              <h3 class="soliseed-product-card__title">
                {%- if featured_product != blank -%}
                  <a href="{{ featured_product.url }}">{{ featured_product.title | escape }}</a>
                {%- else -%}
                  <span>{{ block.settings.placeholder_title | escape }}</span>
                {%- endif -%}
              </h3>

              {%- if block.settings.content != blank -%}
                <div class="soliseed-product-card__description rte">
                  {{ block.settings.content }}
                </div>
              {%- endif -%}

              <div class="soliseed-product-card__cta">
                {%- render 'buy-on-amazon-button', product: featured_product, button_class: 'button button--primary button--full' -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed featured items",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers for Real Growing Spots."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Choose the Soliseed setup that fits where your plant actually lives.</p>"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Placeholder title",
          "default": "Soliseed grow light"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed featured items"
    }
  ]
}
{% endschema %}
