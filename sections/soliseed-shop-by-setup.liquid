<style>
  #shopify-section-{{ section.id }} .soliseed-setup-grid {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .soliseed-setup-card {
    padding: 24px;
    min-height: 140px;
    background: rgb(var(--secondary-background));
    border-radius: var(--block-border-radius);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .soliseed-setup-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<section class="section">
  <div class="section__color-wrapper section--padding">
    <div class="container">
      <header class="section__header section__header--center text-container mx-auto">
        {%- if section.settings.title != blank -%}
          <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </header>

      <div class="soliseed-setup-grid">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="soliseed-setup-card text-container" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <span class="heading h4">{{ block.settings.title | escape }}</span>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <span class="heading heading--small link">{{ block.settings.link_label | escape }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Soliseed shop by setup",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Clip it. Hang it. Place it. Grow there."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>From clip-on lights to pendant grow lights, Soliseed gives every growing spot a better way to receive light.</p>"
    }
  ],
  "blocks": [
    {
      "type": "setup",
      "name": "Setup",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop setup"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soliseed shop by setup"
    }
  ]
}
{% endschema %}